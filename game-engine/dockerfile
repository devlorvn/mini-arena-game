FROM golang:1.21-alpine AS base

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

FROM base AS development
COPY . .
RUN go install github.com/cosmtrek/air@latest
EXPOSE 8080
CMD ["air", "-c", ".air.toml"]

FROM base AS builder
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /game-engine ./cmd/server

FROM alpine:latest AS production
RUN apk --no-cache add ca-certificates
WORKDIR /root/
COPY --from=builder /game-engine .
EXPOSE 8080
CMD ["./game-engine"]